interfaces {
    loopback lo {
    }
}
service {
    ssh {
        port "22"
    }
}
system {
    host-name "vyos"
    update-check {
        url "https://raw.githubusercontent.com/frogro/vyos-build-pi5/rolling/version.json"
    }
    login {
        user vyos {
            authentication {
                plaintext-password "vyos"
            }
        }
    }
}
